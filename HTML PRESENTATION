                            "Isang grupo ng mga Pilipino noong panahon ng Espanyol ang tumangging iwanan ang kanilang paniniwala sa mga Anito at lumipat sa bundok. Paano nagbigay ng direksyon at kabuluhan sa kanilang buhay (at sa kasaysayan natin) ang pananampalatayang ito?"
                        </p>
                    </div>
                    
                    <button onclick="document.getElementById('floating-timer-container').classList.add('visible'); document.getElementById('floating-timer-container').style.display='flex';" class="bg-belief-teal text-white hover:bg-teal-500 px-6 md:px-8 py-3 rounded-full font-bold text-lg md:text-xl transition-colors shadow-lg">
                        <i class="fas fa-clock mr-2"></i> Ilabas ang Timer (15 Minuto)
                    </button>
                </div>
            </div>
        </div>

        <!-- SLIDE 20: Presentasyon -->
        <div class="slide">
            <div class="slide-inner">
                <div class="text-center mb-8 md:mb-12">
                    <i class="stagger-1 fas fa-microphone-lines text-[5rem] md:text-[8rem] text-belief-gold mb-6 drop-shadow-sm animate-float"></i>
                    <h2 class="stagger-1 font-heading text-4xl md:text-7xl font-bold text-white tracking-widest uppercase">Ibahagi ang Kaisipan</h2>
                </div>
                
                <div class="stagger-2 glass w-full max-w-4xl rounded-[2rem] p-8 md:p-12 border-t-[12px] border-belief-gold text-center shadow-2xl mx-auto">
                    <p class="text-xl md:text-3xl text-white mb-8 leading-relaxed font-light">
                        Pipili tayo ng 2 hanggang 3 grupo na magbabahagi ng kanilang mga naging sagot at pananaw.
                    </p>
                    <div class="bg-belief-navy/40 p-6 rounded-xl border border-belief-navy shadow-inner">
                        <p class="text-lg md:text-2xl text-slate-300 italic hl-text">Maging handa at makinig nang may paggalang sa pananaw ng ibang grupo.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 21: Sintesis at Kasunduan -->
        <div class="slide">
            <div class="slide-inner">
                <div class="max-w-5xl w-full text-center glass p-12 md:p-16 rounded-[3rem] border-t-[16px] border-belief-rust relative overflow-hidden shadow-2xl mx-auto">
                    <i class="fas fa-book-journal-whills text-[12rem] md:text-[20rem] absolute -right-10 -bottom-10 text-belief-rust opacity-10 transform rotate-[15deg]"></i>
                    <h2 class="stagger-1 text-4xl md:text-6xl font-heading font-bold text-white mb-6 uppercase tracking-widest drop-shadow-lg">Sintesis at Kasunduan</h2>
                    <div class="stagger-1 h-2 w-32 md:w-48 bg-belief-gold mx-auto my-6 rounded-full"></div>
                    
                    <div class="stagger-2 bg-black/50 p-6 md:p-8 rounded-2xl border border-belief-rust/30 shadow-inner mt-4 text-left mb-8 relative z-10">
                        <p class="text-xl md:text-3xl text-belief-gold font-bold uppercase tracking-widest mb-4"><i class="fas fa-pen-nib mr-3"></i>Exit Ticket (Pagninilay):</p>
                        <p class="text-base md:text-2xl text-white font-medium leading-relaxed hl-text">
                            Isulat sa inyong kwaderno: "Bilang isang kabataan ngayon, paano ko gagamitin ang aking mga paniniwala upang makatulong sa pagbuo ng isang mabuting kasaysayan para sa ating bansa?"
                        </p>
                    </div>
                    
                    <p class="stagger-3 text-lg md:text-2xl text-slate-300 font-bold relative z-10">Tapos na ang Pinagsamang Sesyon 1 at 2. Magandang Araw!</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Draggable Floating Timer -->
    <div id="floating-timer-container">
        <i class="fas fa-grip-lines-vertical text-gray-500 cursor-move hidden md:block"></i>
        <i class="fas fa-stopwatch text-belief-gold text-xl md:text-2xl animate-pulse"></i>
        <div id="ft-display">15:00</div>
        <div class="flex gap-2">
            <button id="ft-play" class="ft-btn"><i class="fas fa-play"></i></button>
            <button id="ft-pause" class="ft-btn hidden"><i class="fas fa-pause"></i></button>
            <button id="ft-reset" class="ft-btn"><i class="fas fa-rotate-right"></i></button>
            <button id="ft-close" class="ft-btn bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white"><i class="fas fa-times"></i></button>
        </div>
    </div>

    <!-- Navigation Panel -->
    <div id="nav-panel">
        <button id="btnPinNav" class="nav-btn" aria-label="Pin Navigation" title="Pin Navigation">
            <i class="fa-solid fa-thumbtack" style="transform: rotate(-45deg);"></i>
        </button>
        <div class="h-4 md:h-6 w-px bg-white/20 mx-0.5 md:mx-1"></div> 
        
        <button id="btnForceBg" class="nav-btn" aria-label="Reload Background" title="Force Reload Background" onclick="reloadBackground()">
            <i class="fas fa-image"></i>
        </button>
        <button onclick="document.getElementById('floating-timer-container').classList.toggle('visible'); document.getElementById('floating-timer-container').style.display = document.getElementById('floating-timer-container').classList.contains('visible') ? 'flex' : 'none';" class="nav-btn text-belief-gold hover:text-white" title="Toggle Timer">
            <i class="fas fa-stopwatch"></i>
        </button>
        <div class="h-4 md:h-6 w-px bg-white/20 mx-0.5 md:mx-1"></div> 

        <button id="btnFullscreen" class="nav-btn hidden sm:flex" aria-label="Toggle Fullscreen" title="Toggle Fullscreen">
            <i class="fa-solid fa-expand"></i>
        </button>
        <button id="btnPrev" class="nav-btn" aria-label="Previous Slide">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <div id="slideCounter" class="font-heading text-sm md:text-lg tracking-widest text-slate-100 mx-1 md:mx-2 font-bold">1 / 21</div>
        <button id="btnNext" class="nav-btn btn-next pulsing" aria-label="Next Slide">
            <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>

    <!-- Cinematic 3D Zoom Overlay -->
    <div id="zoom-overlay" onclick="closeZoomModal()">
        <div id="zoom-content-wrapper" onclick="event.stopPropagation()">
            <!-- Content cloned via JS -->
        </div>
    </div>

    <script>
        // --- Force Fetch BG Image Logic ---
        function reloadBackground() {
            const bgLayer = document.querySelector('.bg-layer');
            const baseUrl = 'https://images.unsplash.com/photo-1519074069444-1ba4fff66d16?q=80&w=1920';
            bgLayer.style.backgroundImage = 'none';
            setTimeout(() => {
                bgLayer.style.backgroundImage = `url('${baseUrl}&t=${new Date().getTime()}')`;
            }, 50);
            
            const icon = document.querySelector('#btnForceBg i');
            icon.className = 'fas fa-spinner fa-spin';
            setTimeout(() => {
                icon.className = 'fas fa-check';
                setTimeout(() => { icon.className = 'fas fa-image'; }, 1000);
            }, 800);
        }

        document.addEventListener('DOMContentLoaded', () => {
            
            // --- Slides Management ---
            const slides = document.querySelectorAll('.slide');
            const totalSlides = slides.length;
            let currentSlide = 0;
            
            const btnNext = document.getElementById('btnNext');
            const btnPrev = document.getElementById('btnPrev');
            const slideCounter = document.getElementById('slideCounter');
            const navPanel = document.getElementById('nav-panel');

            function updateSlides() {
                slides.forEach((slide, index) => {
                    slide.classList.remove('active');
                    if (index === currentSlide) {
                        slide.classList.add('active');
                        slide.scrollTop = 0; 
                    }
                });
                
                slideCounter.textContent = `${currentSlide + 1} / ${totalSlides}`;

                if (currentSlide === totalSlides - 1) {
                    btnNext.classList.remove('pulsing');
                } else {
                    btnNext.classList.add('pulsing');
                }
            }

            function nextSlide() {
                if (currentSlide < totalSlides - 1) {
                    currentSlide++;
                    updateSlides();
                }
            }

            function prevSlide() {
                if (currentSlide > 0) {
                    currentSlide--;
                    updateSlides();
                }
            }

            btnNext.addEventListener('click', nextSlide);
            btnPrev.addEventListener('click', prevSlide);

            // --- Keyboard Navigation ---
            let isZoomOpen = false;

            document.addEventListener('keydown', (e) => {
                if (isZoomOpen) {
                    if (e.key === 'Escape') closeZoomModal();
                    return; 
                }

                if (e.key === 'ArrowRight' || e.key === ' ') {
                    e.preventDefault();
                    nextSlide();
                } else if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    prevSlide();
                }
            });

            // --- Cinematic 3D Zoom Feature ---
            const zoomables = document.querySelectorAll('.zoomable');
            const zoomOverlay = document.getElementById('zoom-overlay');
            const zoomContentWrapper = document.getElementById('zoom-content-wrapper');

            window.openZoomModal = function(element) {
                isZoomOpen = true;
                const clone = element.cloneNode(true);
                clone.classList.remove('zoomable', 'cursor-pointer', 'stagger-1', 'stagger-2', 'stagger-3', 'stagger-4', 'stagger-5');
                clone.style.transform = 'none';
                clone.style.boxShadow = 'none';
                
                const style = document.createElement('style');
                style.innerHTML = `#zoom-content-wrapper .zoomable::after { display: none !important; }`;
                
                zoomContentWrapper.innerHTML = '';
                zoomContentWrapper.appendChild(clone);
                zoomContentWrapper.appendChild(style);
                
                zoomOverlay.classList.add('active');
            };

            window.closeZoomModal = function() {
                isZoomOpen = false;
                zoomOverlay.classList.remove('active');
                setTimeout(() => {
                    if (!isZoomOpen) zoomContentWrapper.innerHTML = '';
                }, 400); 
            }

            zoomables.forEach(elem => {
                elem.addEventListener('click', (e) => {
                    if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
                    e.stopPropagation();
                    openZoomModal(elem);
                });
            });

            // --- Word Highlight Feature ---
            function wrapWordsInElement(element) {
                if (element.classList.contains('words-wrapped')) return;
                element.classList.add('words-wrapped');

                const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
                const textNodes = [];
                let node;
                while (node = walker.nextNode()) {
                    if (node.nodeValue.trim() !== '') {
                        const parentTag = node.parentNode.tagName.toLowerCase();
                        if (!['script', 'style', 'i', 'button', 'a'].includes(parentTag)) {
                            textNodes.push(node);
                        }
                    }
                }
                textNodes.forEach(textNode => {
                    const words = textNode.nodeValue.split(/(\s+)/);
                    const fragment = document.createDocumentFragment();
                    words.forEach(word => {
                        if (word.trim() === '') {
                            fragment.appendChild(document.createTextNode(word));
                        } else {
                            const span = document.createElement('span');
                            span.className = 'word-hl';
                            span.textContent = word;
                            fragment.appendChild(span);
                        }
                    });
                    textNode.parentNode.replaceChild(fragment, textNode);
                });
            }

            document.querySelectorAll('.hl-text').forEach(wrapWordsInElement);

            document.addEventListener('click', (e) => {
                if (e.target.classList.contains('word-hl')) {
                    e.stopPropagation(); 
                    e.target.classList.toggle('active');
                }
            });

            // --- Fullscreen API ---
            const btnFullscreen = document.getElementById('btnFullscreen');
            if(btnFullscreen){
                const iconFullscreen = btnFullscreen.querySelector('i.fa-expand, i.fa-compress');

                btnFullscreen.addEventListener('click', () => {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(err => {
                            console.error(`Error attempting to enable full-screen mode: ${err.message}`);
                        });
                        iconFullscreen.classList.replace('fa-expand', 'fa-compress');
                    } else {
                        document.exitFullscreen();
                        iconFullscreen.classList.replace('fa-compress', 'fa-expand');
                    }
                });
            }

            // --- Dynamic Auto-Hide Navigation Panel ---
            const btnPinNav = document.getElementById('btnPinNav');
            const iconPinNav = btnPinNav.querySelector('i');
            
            let navTimeout;
            let isNavPinned = false;

            function showNav() {
                navPanel.classList.remove('minimized');
                resetNavTimer();
            }

            function resetNavTimer() {
                clearTimeout(navTimeout);
                if (!isNavPinned) {
                    navTimeout = setTimeout(() => {
                        navPanel.classList.add('minimized');
                    }, 2500);
                }
            }

            document.addEventListener('mousemove', showNav);
            document.addEventListener('keydown', showNav);
            document.addEventListener('touchstart', showNav);
            navPanel.addEventListener('mouseenter', () => clearTimeout(navTimeout));
            navPanel.addEventListener('mouseleave', resetNavTimer);

            btnPinNav.addEventListener('click', () => {
                isNavPinned = !isNavPinned;
                if (isNavPinned) {
                    iconPinNav.style.transform = 'rotate(0deg)'; 
                    iconPinNav.classList.add('text-belief-gold');
                    iconPinNav.classList.remove('text-white');
                    clearTimeout(navTimeout); 
                } else {
                    iconPinNav.style.transform = 'rotate(-45deg)'; 
                    iconPinNav.classList.remove('text-belief-gold');
                    iconPinNav.classList.add('text-white');
                    resetNavTimer(); 
                }
            });

            // --- Draggable Timer Logic ---
            const ftContainer = document.getElementById('floating-timer-container');
            const ftDisplay = document.getElementById('ft-display');
            const ftPlay = document.getElementById('ft-play');
            const ftPause = document.getElementById('ft-pause');
            const ftReset = document.getElementById('ft-reset');
            const ftClose = document.getElementById('ft-close');

            let timerInterval;
            let timeRemaining = 15 * 60; // 15 mins
            let isTimerRunning = false;

            function updateTimerDisplay() {
                let m = Math.floor(timeRemaining / 60);
                let s = timeRemaining % 60;
                ftDisplay.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                if(timeRemaining <= 60 && timeRemaining > 0) {
                    ftDisplay.style.color = '#ef4444'; // Red warning
                } else {
                    ftDisplay.style.color = '#fbbf24';
                }
            }

            ftPlay.addEventListener('click', () => {
                if (!isTimerRunning && timeRemaining > 0) {
                    isTimerRunning = true;
                    ftPlay.classList.add('hidden');
                    ftPause.classList.remove('hidden');
                    timerInterval = setInterval(() => {
                        timeRemaining--;
                        updateTimerDisplay();
                        if (timeRemaining <= 0) {
                            clearInterval(timerInterval);
                            isTimerRunning = false;
                            ftPause.classList.add('hidden');
                            ftPlay.classList.remove('hidden');
                        }
                    }, 1000);
                }
            });

            ftPause.addEventListener('click', () => {
                clearInterval(timerInterval);
                isTimerRunning = false;
                ftPause.classList.add('hidden');
                ftPlay.classList.remove('hidden');
            });

            ftReset.addEventListener('click', () => {
                clearInterval(timerInterval);
                isTimerRunning = false;
                timeRemaining = 15 * 60;
                updateTimerDisplay();
                ftPause.classList.add('hidden');
                ftPlay.classList.remove('hidden');
            });

            ftClose.addEventListener('click', () => {
                ftContainer.style.display = 'none';
                ftContainer.classList.remove('visible');
            });

            // Make Timer Draggable
            let isDragging = false, currentX, currentY, initialX, initialY, xOffset = 0, yOffset = 0;

            ftContainer.addEventListener("mousedown", dragStart);
            ftContainer.addEventListener("touchstart", dragStart, {passive: false});
            document.addEventListener("mouseup", dragEnd);
            document.addEventListener("touchend", dragEnd);
            document.addEventListener("mousemove", drag);
            document.addEventListener("touchmove", drag, {passive: false});

            function dragStart(e) {
                if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
                
                if (e.type === "touchstart") {
                    initialX = e.touches[0].clientX - xOffset;
                    initialY = e.touches[0].clientY - yOffset;
                } else {
                    initialX = e.clientX - xOffset;
                    initialY = e.clientY - yOffset;
                }

                if (e.target === ftContainer || e.target.closest('#floating-timer-container')) {
                    isDragging = true;
                }
            }

            function dragEnd() {
                initialX = currentX;
                initialY = currentY;
                isDragging = false;
            }

            function drag(e) {
                if (isDragging) {
                    e.preventDefault();
                    
                    if (e.type === "touchmove") {
                        currentX = e.touches[0].clientX - initialX;
                        currentY = e.touches[0].clientY - initialY;
                    } else {
                        currentX = e.clientX - initialX;
                        currentY = e.clientY - initialY;
                    }

                    xOffset = currentX;
                    yOffset = currentY;
                    ftContainer.style.transform = `translate(calc(-50% + ${currentX}px), ${currentY}px)`;
                }
            }

            // Init
            resetNavTimer();
            updateSlides();
            updateTimerDisplay();
        });
    </script>
</body>
</html>
